pipeline {
    agent any

    stages {
        stage('Cleanup Old Container') {
            steps {
                sh 'docker stop test-web-app || true'
                sh 'docker rm test-web-app || true'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building image from GitHub source...'
                sh 'docker build -t github-nginx-app:v1 .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Spinning up container on port 8083...'
                sh 'docker run -d -p 8083:80 --name test-web-app github-nginx-app:v1'
            }
        }
    }
}
