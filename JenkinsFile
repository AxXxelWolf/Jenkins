pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'v1.0', description: 'Specify image version tag')
        choice(name: 'DEPLOY_ENV', choices: ['dev', 'staging', 'production'], description: 'Select deployment environment')
    }

    stages {
        stage('Parallel Quality Checks') {
            parallel {
                stage('Run Linter') {
                    steps {
                        echo "🔍 Running static code linting..."
                        sh 'sleep 5'
                    }
                }
                stage('Run Security Scan') {
                    steps {
                        echo "🔒 Scanning dependencies for vulnerabilities..."
                        sh 'sleep 5'
                    }
                }
                stage('Run Unit Tests') {
                    steps {
                        echo "🧪 Executing test suite for ${params.DEPLOY_ENV}..."
                        sh 'sleep 5'
                    }
                }
            }
        }

        stage('Build & Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh """
                        echo "Building version ${params.IMAGE_TAG}..."
                        docker build -t \$DOCKER_USER/github-nginx-app:${params.IMAGE_TAG} .
                        echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                        docker push \$DOCKER_USER/github-nginx-app:${params.IMAGE_TAG}
                    """
                }
            }
        }
    }
}
